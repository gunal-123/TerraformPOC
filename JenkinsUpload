pipeline {
    agent any
    environment {
        AWS_CRED = credentials('dfc9e103-3678-426e-89b5-e670590c1b30')
        AWS_DEFAULT_REGION = 'us-east-1'
    }
    parameters {
        string(name: 'primaryBucket', description: 'Primary bucket name')
        string(name: 'secondaryBucket', description: 'Secondary bucket name')
        string(name: 'domainID', description: 'Distribution domain id')
    }
    stages {
        stage ('Clone') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[credentialsId: 'eb0e167d-13d9-4045-8240-760541fd6d79', 
                                         url: 'https://github.com/gunal-123/TerraformPOC.git']])
            }
        }
        stage ('upload objects') {
            steps {
                s3Upload(
                    bucket: "${params.primaryBucket}",
                    file: 'pages',
                    path: 'pages')
            }
        }
        stage ('wait') {
            steps {
                sleep time: 1, unit: 'MINUTES'
            }
        }
        stage ('delete') {
            steps {
                s3Delete bucket: "${params.primaryBucket}", path: 'pages/index.html'
            }
        }
        stage ('invalidation') {
            steps {
                sh """aws cloudfront create-invalidation --distribution-id "${params.domainID}" --paths \"/pages/index.html\""""
            }
        }
        stage ('test upload') {
             environment {
                AWS_DEFAULT_REGION = 'us-west-2'
            }
            steps {
                s3Upload(
                    bucket: "${params.secondaryBucket}",
                    file: 'test/index.html',
                    path: 'pages/index.html')
            }
        }
    }
}
